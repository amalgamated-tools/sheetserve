package web

// operator names who runs this server, for its privacy policy and terms.
type operator struct {
	Name    string // such as a company; empty means "the operator of this server"
	Contact string // an email address or URL; empty leaves it out
	BaseURL string
}

func (o operator) who() string {
	if o.Name != "" {
		return o.Name
	}
	return "the operator of this server"
}

// legalLinks links the privacy policy and terms, as Google requires of an app's home page.
templ legalLinks() {
	<p class="legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
}

templ contact(o operator) {
	if o.Contact != "" {
		Contact { o.who() } at { o.Contact }.
	} else {
		Contact { o.who() }.
	}
}

templ privacyView(o operator) {
	@document("Privacy policy") {
		<main class="doc">
			<a class="back" href="/">← sheetserve</a>
			<h1>Privacy policy</h1>
			<p>This sheetserve server at <code>{ o.BaseURL }</code> is run by { o.who() }. This page says what it stores and why.</p>
			<h2>What it stores</h2>
			<ul>
				<li>Your Google account ID and email address, to sign you in.</li>
				<li>The refresh token Google issues when you sign in, encrypted, so the server can reach your spreadsheets when an API key is used.</li>
				<li>The spreadsheets you add, by their Google ID and title, and your settings for them: allowed operations, column types and key columns.</li>
				<li>Your API keys, as SHA-256 hashes only.</li>
				<li>Logs of each request, with the key name, status and time, and of each change you make in the dashboard.</li>
			</ul>
			<h2>Your spreadsheets</h2>
			<p>
				sheetserve asks Google only for the <code>drive.file</code> scope, so it can open only the spreadsheets you pick or create with it.
				It reads and writes them when you use the dashboard or one of your API keys does.
				Their contents pass through the server and may be held in memory for a short cache time. They are not written to disk or logs.
			</p>
			<h2>Google user data</h2>
			<p>
				sheetserve's use and transfer of information received from Google APIs to any other app will adhere to the
				<a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>,
				including the Limited Use requirements. Your data is used only to serve your own API and dashboard. It is never sold,
				used for advertising, or shared, except with the people you give API keys to.
			</p>
			<h2>Removing your data</h2>
			<p>
				Remove a spreadsheet or key in the dashboard to delete it. An admin can remove your account, which deletes your token,
				spreadsheets and keys. You can also revoke sheetserve's access at <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>.
			</p>
			<p>
				@contact(o)
			</p>
		</main>
	}
}

templ termsView(o operator) {
	@document("Terms") {
		<main class="doc">
			<a class="back" href="/">← sheetserve</a>
			<h1>Terms of service</h1>
			<p>By signing in to the sheetserve server at <code>{ o.BaseURL }</code>, run by { o.who() }, you agree to these terms.</p>
			<ul>
				<li>Use it only with spreadsheets you are allowed to share, and keep your API keys secret. Anyone with a key can do what it allows.</li>
				<li>Don't use it to break the law, to harm others, or to get around Google's own limits and terms.</li>
				<li>The service is provided as is, without warranty. It may change, go down, or lose settings. Keep your own copy of anything important; your data stays in your Google Sheets.</li>
				<li>Accounts can be suspended or removed, such as after abuse.</li>
				<li>The <a href="/privacy">privacy policy</a> says what is stored.</li>
			</ul>
			<p>@contact(o)</p>
		</main>
	}
}
