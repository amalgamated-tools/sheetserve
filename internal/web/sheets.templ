package web

import (
	"fmt"
	"net/url"
	"slices"

	"github.com/amalgamated-tools/sheetserve/internal/db"
)

templ sheetsView(s shell, sheets []sheetView, pickerKey, appID string) {
	@layout(s, "https://apis.google.com/js/api.js", "/static/sheets.js") {
		<div class="page-head with-action">
			<div>
				<h1>Spreadsheets</h1>
				<p>Turn on the ops each tab allows, then <a href="/keys">create a key</a> { "for it." }</p>
			</div>
			<a class="button primary" href="/sheets/new">+ Create spreadsheet</a>
		</div>
		for _, sh := range sheets {
			@sheetCard(sh)
		}
		if len(sheets) == 0 {
			<div class="empty">No spreadsheets yet. <a href="/sheets/new">Create a blank one</a>, or add one from your Google Drive below.</div>
		}
		<h2 id="add-sheet">Add a spreadsheet</h2>
		<section class="card">
			<h3>From Google Drive</h3>
			<div id="pick-area">
				<div class="actions"><button id="pick" class="primary" type="button" data-picker-key={ pickerKey } data-app-id={ appID }>Choose from Google Drive</button></div>
				<p class="hint">If the picker asks you to sign in, allow docs.google.com in your tracker blocker (such as Privacy Badger) or allow third-party cookies for this site.</p>
			</div>
			<form id="add" method="post" action="/app/sheets" hidden>
				<input type="hidden" name="google_id"/>
				<input type="hidden" name="title"/>
				<p>Adding <strong id="picked"></strong></p>
				@nameField("")
				<div class="actions"><button class="primary">Add</button> <button type="button" id="add-cancel">Cancel</button></div>
			</form>
		</section>
	}
}

templ sheetCard(sh sheetView) {
	<section class="card" id={ "sheet-" + sh.Name }>
		<div class="card-head">
			<div><h3>{ sh.Name }</h3> <small><a href={ templ.URL("https://docs.google.com/spreadsheets/d/" + url.PathEscape(sh.GoogleID) + "/edit") } target="_blank" rel="noopener" title="Open in Google Sheets">{ sh.Title } ↗</a></small></div>
			<div>
				<a class="button small" href={ templ.SafeURL(columnsURL(sh.Name)) }>Columns</a>
				<form class="inline" method="post" action="/app/sheets/delete" data-confirm={ "Remove " + sh.Name + "? Keys scoped to it stop working." }>
					<input type="hidden" name="name" value={ sh.Name }/>
					<button class="danger small">Remove</button>
				</form>
			</div>
		</div>
		<p class="hint">Endpoint: <code><span class="origin"></span>/v1/{ sh.Name }/&lt;tab&gt;</code>. Row 1 of each tab is its header. Set each column's type and the tab's key column under Columns.</p>
		if len(sh.Tabs) > 0 {
			<div class="table-wrap">
				<table>
					<tr><th>Tab</th><th>Allowed ops</th><th>Columns</th></tr>
					for _, t := range sh.Tabs {
						@tabRow(sh.Name, "ops-"+sh.Name, t)
					}
				</table>
			</div>
			<form id={ "ops-" + sh.Name } class="ops-form actions" method="post" action="/app/tabs">
				<input type="hidden" name="sheet" value={ sh.Name }/>
				for _, t := range sh.Tabs {
					<input type="hidden" name="tab" value={ t.Name }/>
				}
				<button>Save ops</button>
			</form>
		} else {
			<p class="muted">No tabs found.</p>
		}
	</section>
}

// tabRow shows one tab's ops, whose checkboxes belong to the spreadsheet's form f, and its columns.
templ tabRow(sheet, f string, t tabView) {
	<tr>
		<td><strong>{ t.Name }</strong></td>
		<td>
			<div class="chips">
				for _, op := range db.AllOps {
					<label class="chip"><input type="checkbox" form={ f } name={ "ops:" + t.Name } value={ op } checked?={ slices.Contains(t.Ops, op) }/> { op }</label>
				}
			</div>
		</td>
		<td class="muted">
			key <code>{ t.Key }</code>
			if t.Typed > 0 {
				· { fmt.Sprint(t.Typed) } typed
			} else {
				· <a href={ templ.SafeURL(columnsURL(sheet)) }>untyped, set column types</a>
			}
			if t.Hidden > 0 {
				· { fmt.Sprint(t.Hidden) } hidden
			}
		</td>
	</tr>
}

// nameField asks for a spreadsheet's name in URLs.
templ nameField(value string) {
	<label class="field">
		<span>Name in URLs</span>
		<input name="name" value={ value } pattern="[A-Za-z0-9_\-]+" required/>
		<span class="hint">Letters, digits, - or _. Used in <code>/v1/&lt;name&gt;/&lt;tab&gt;</code> and in key scopes.</span>
	</label>
}

templ newSheetView(s shell, form newSheetForm) {
	@layout(s, "/static/new-sheet.js") {
		<div class="page-head">
			<a class="back" href="/sheets">← Spreadsheets</a>
			<h1>Create a spreadsheet</h1>
			<p>sheetserve creates a blank spreadsheet in your Google Drive, writes each tab's header row, and adds it here with its column types.</p>
		</div>
		<form id="new-sheet" method="post" action="/app/sheets/new">
			<section class="card">
				<label class="field"><span>Title in Drive</span><input name="title" value={ form.Title } placeholder="Same as the name"/></label>
				@nameField(form.Name)
			</section>
			<h2>Tabs</h2>
			<p class="hint">Each tab is like a table: list its columns, their types, and the key column that finds a row. With no key column, sheetserve adds an <code>id</code> column first and fills it in on each create.</p>
			<div id="tabs">
				for i, t := range form.Tabs {
					@newTabCard(fmt.Sprintf("t%d", i), t)
				}
			</div>
			<div class="actions"><button type="button" id="add-tab">+ Add tab</button></div>
			// The script copies these for new tabs and columns, then numbers their inputs.
			<template id="tab-template">
				@newTabCard("tnew", tabForm{Columns: []columnForm{{Type: "string"}}})
			</template>
			<template id="column-template">
				@newColumnRow("tnew", "tnewcnew", "", columnForm{Type: "string"})
			</template>
			<div class="actions"><button class="primary">Create spreadsheet</button> <a class="button" href="/sheets">Cancel</a></div>
		</form>
	}
}

// newTabCard is one tab on the new spreadsheet page. Its inputs are named from ti; see parseTabs.
templ newTabCard(ti string, t tabForm) {
	<section class="card tab-card">
		<div class="card-head">
			<label class="tab-name"><span>Tab</span> <input data-f="tab" name={ ti } value={ t.Name } placeholder="Orders" aria-label="Tab name"/></label>
			<button type="button" class="danger small" data-remove-tab>Remove tab</button>
		</div>
		<div class="table-wrap">
			<table class="columns builder">
				<thead><tr><th>Column</th><th>Type</th><th>Required</th><th>Default</th><th>Key</th><th></th></tr></thead>
				<tbody>
					for j, c := range t.Columns {
						@newColumnRow(ti, fmt.Sprintf("%sc%d", ti, j), t.Key, c)
					}
					if len(t.Columns) == 0 {
						@newColumnRow(ti, ti+"c0", t.Key, columnForm{Type: "string"})
					}
				</tbody>
				<tfoot>
					<tr>
						<td colspan="4"><button type="button" class="small" data-add-column>+ Add column</button></td>
						<td colspan="2"><label><input type="radio" data-f="key" name={ ti + "key" } value="" checked?={ t.Key == "" }/> Add <code>id</code></label></td>
					</tr>
				</tfoot>
			</table>
		</div>
	</section>
}

templ newColumnRow(ti, cj, key string, c columnForm) {
	<tr>
		<td><input data-f="col" name={ cj } value={ c.Name } placeholder="item" aria-label="Column name"/></td>
		<td>
			<select class="col-type" data-f="type" name={ cj + "type" } aria-label="Column type">
				for _, o := range columnTypeOptions {
					<option value={ o.Type } selected?={ c.Type == o.Type }>{ o.Label }</option>
				}
			</select>
			@enumOptions(cj, c.Options, "", c.Type)
		</td>
		<td><input type="checkbox" data-f="required" name={ cj + "required" } value="1" checked?={ c.Required } aria-label="Required"/></td>
		<td><input data-f="default" name={ cj + "default" } value={ c.Default } aria-label="Default"/></td>
		<td><input type="radio" data-f="key" name={ ti + "key" } value={ c.Name } checked?={ c.Name != "" && c.Name == key } aria-label="Key column"/></td>
		<td class="right"><button type="button" class="small" data-remove-column aria-label="Remove column">×</button></td>
	</tr>
}
