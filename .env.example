# Copy to .env and fill in. mise loads .env into every task. See "Setup" in the README.

# Required
SHEETSERVE_BASE_URL=http://localhost:8085
# Generate with: openssl rand -base64 32
SHEETSERVE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Optional
# SHEETSERVE_DB=sheetserve.db
# SHEETSERVE_CACHE_TTL=60s
# SHEETSERVE_CORS_ORIGINS=https://app.example.com
# SHEETSERVE_AUTH_RELAY=https://sheetserve.onrender.com/auth/relay
# SHEETSERVE_RELAY_ORIGINS=https://sheetserve-pr-*.onrender.com
# PORT=8085

# Only for the live integration test (mise run test:live): Google credentials that can edit the sheet.
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# SHEETSERVE_LIVE_SHEET_ID=
