# Copy to .env and uncomment what you need. mise loads .env into every task.

# Hosted mode (Google sign-in). See "Hosted mode" in the README.
# SHEETSERVE_CONFIG=/nonexistent
# SHEETSERVE_BASE_URL=http://localhost:8080
# Generate with: openssl rand -base64 32
# SHEETSERVE_SECRET=
# SHEETSERVE_DB=sheetserve.db
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PROJECT_NUMBER=

# Live integration test (mise run test:live)
# SHEETSERVE_LIVE_SHEET_ID=
