# Copy to .env and fill in
# Required
SHEETSERVE_BASE_URL=http://localhost:8080

# Generate with: openssl rand -base64 32
SHEETSERVE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Optional
# SHEETSERVE_DB=sheetserve.db

# --- Deployment label -----------------------------------------------------
# Human-readable label for this deployment, prefixed to the messages the agent
# posts and to the slash command name (default: Dev locally).
# ENVIRONMENT=Dev

# --- Logging --------------------------------------------------------------
# Console log format (default: json, the production format). Options: json, text.
LOG_FORMAT=text

# Log level for the application (default: info). Options: debug, info, warn, error.
LOG_LEVEL=info

# Whether to disable colored output in logs (default: false).
NO_COLOR=false
# --- OpenTelemetry --------------------------------------------------------
# OpenTelemetry export (optional). OTLP exporters use the collector below.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Per-signal exporter selection (default: otlp). All exporters are disabled in
# this local template so running without a collector stays quiet. Start the
# collector and change the signals you want to export to "otlp".
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# SHEETSERVE_CACHE_TTL=60s
# SHEETSERVE_CORS_ORIGINS=https://app.example.com
# PORT=8080

# Optional service account: lets users add spreadsheets shared with it by URL.
# Also needed by the live integration test (mise run test:live).
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# SHEETSERVE_LIVE_SHEET_ID=
