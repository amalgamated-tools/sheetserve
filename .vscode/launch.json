{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/server",
            "envFile": "${workspaceFolder}/.env",
            "showLog": false,
            "dlvFlags": [
                "--log-output="
            ],
            "debugAdapter": "dlv-dap",
            "backend": "lldb"
        }
    ]
}